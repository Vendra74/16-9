{
  "expo": {
    "name": "SixteenNine",
    "slug": "sixteen-nine",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "sixteennine",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "br.com.vendra.sixteennine",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "16:9"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.vendra.sixteennine"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-landscape",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O 16:9 abre suas fotos e vídeos para você publicar trabalhos e escolher a foto de perfil.",
          "cameraPermission": "O 16:9 usa a câmera para você gravar vídeos e publicar.",
          "microphonePermission": "O 16:9 usa o microfone para gravar o som dos seus vídeos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O 16:9 usa a câmera para você gravar vídeos e publicar.",
          "microphonePermission": "O 16:9 usa o microfone para gravar o som dos seus vídeos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#000000"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "pt",
            "en",
            "es",
            "fr",
            "it",
            "de"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt": "./locales/pt.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json",
      "de": "./locales/de.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63f4fa58-1428-415c-86db-1fb48d20dad8"
      }
    },
    "owner": "vendra74s-team"
  }
}
